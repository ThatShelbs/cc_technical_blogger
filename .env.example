# Copy to .env (never commit .env). Every value is optional: Proseferno works with
# smart defaults and stores secrets you enter in the app in your OS keychain.

# Where Proseferno keeps its database, personas, samples, projects and exports.
# PROSEFERNO_DATA_DIR=./data

# Port for the local web app.
# PROSEFERNO_PORT=8732

# Folder of your own writing to offer for import on first run.
# PROSEFERNO_SEED_SAMPLES_DIR=./my_writing_examples

# Claude model and effort per task (advanced).
# PROSEFERNO_MODEL=claude-opus-5-5
# PROSEFERNO_USE_FALLBACKS=true

# Claude credentials. Prefer "Sign in with Claude" in the app (uses `ant auth login`).
# ANTHROPIC_API_KEY=

# Cloudflare Workers AI (FLUX.2 klein) for hero and meme images.
# PROSEFERNO_CLOUDFLARE_ACCOUNT_ID=
# PROSEFERNO_CLOUDFLARE_API_TOKEN=
