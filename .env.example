# Copy to .env (never commit .env). Every value is optional: Inferno Ghostwriter works with
# smart defaults and stores secrets you enter in the app in your OS keychain.

# Where Inferno Ghostwriter keeps its database, personas, samples, projects and exports.
# INFERNO_GHOSTWRITER_DATA_DIR=./data

# Port for the local web app.
# INFERNO_GHOSTWRITER_PORT=8732

# Folder of your own writing to offer for import on first run.
# INFERNO_GHOSTWRITER_SEED_SAMPLES_DIR=./my_writing_examples

# Claude model and effort per task (advanced).
# INFERNO_GHOSTWRITER_MODEL=claude-opus-5-5
# INFERNO_GHOSTWRITER_USE_FALLBACKS=true

# Claude credentials. Prefer "Sign in with Claude" in the app (uses `ant auth login`).
# ANTHROPIC_API_KEY=

# Claude judge in the AI-detection report (the free scan always runs).
# INFERNO_GHOSTWRITER_AI_DETECTION=true

# References: web searches per reference, and whether to drop links that are gone (404/410/no such host).
# INFERNO_GHOSTWRITER_REFERENCE_MAX_SEARCHES=3
# INFERNO_GHOSTWRITER_CHECK_REFERENCE_LINKS=true

# Demo mode (also `launch.bat --demo`): canned responses; start with the example persona and post.
# INFERNO_GHOSTWRITER_DEMO=false
# INFERNO_GHOSTWRITER_DEMO_SEED=true
